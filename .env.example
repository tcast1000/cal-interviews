# ============================================================
# Interview Prep Automation — Configuration
# Copy this file to .env and fill in your values
# ============================================================

# REQUIRED: Anthropic API key (get one at https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# REQUIRED: Path to your Google OAuth credentials JSON file
# Download from Google Cloud Console (see setup_guide.md)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# OPTIONAL: Your name (used to detect interview events with your name in the title)
# If not set, auto-detected from your Google profile
USER_NAME=

# OPTIONAL: Alternate names/aliases to also match in event titles (comma-separated)
# Example: USER_ALIASES=Theodore Castro,Theodore
USER_ALIASES=

# OPTIONAL: Your email (used to filter calendar events)
# If not set, auto-detected from your Google profile
USER_EMAIL=

# OPTIONAL: How many days ahead to scan for interviews (default: 14)
LOOK_AHEAD_DAYS=14

# OPTIONAL: Poll interval in minutes for --watch mode (default: 30)
POLL_INTERVAL_MINUTES=30

# OPTIONAL: Tavily API key for higher-quality web search
# Get a free key (1000 searches/mo) at https://tavily.com/
# If not set, DuckDuckGo is used (completely free, no key needed)
TAVILY_API_KEY=

# OPTIONAL: Which Claude model to use (default: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# OPTIONAL: Google Sheet ID for the interview tracker
# If not set, a new sheet is created on first run
GOOGLE_SHEET_ID=

# OPTIONAL: Google Drive folder ID to store prep docs in
# If not set, docs are created in your Drive root
DRIVE_FOLDER_ID=

# OPTIONAL: Path to your resume (txt or md) for personalized prep
# The tool will tailor talking points to your specific experience
RESUME_PATH=

# OPTIONAL: Comma-separated list of Google Calendar IDs to scan
# Default is "primary". Add secondary/shared calendars here.
# Example: CALENDAR_IDS=primary,company-interviews@group.calendar.google.com
CALENDAR_IDS=primary

# OPTIONAL: Additional recruiting platform domains to recognize (comma-separated)
# These are merged with the built-in list (greenhouse.io, lever.co, etc.)
# Example: EXTRA_RECRUITING_DOMAINS=mycompany-recruiting.com,custom-ats.io
EXTRA_RECRUITING_DOMAINS=

# OPTIONAL: Extra keywords that should always flag an event as an interview (comma-separated)
# Example: EXTRA_MATCH_KEYWORDS=acme corp,initech
EXTRA_MATCH_KEYWORDS=

# OPTIONAL: ngrok auth token for webhook server (get free at https://ngrok.com/)
# Required only if using webhook_server.py for push notifications
NGROK_AUTH_TOKEN=

# OPTIONAL: ngrok static domain (free accounts get one, e.g. your-name.ngrok-free.app)
# Find yours at https://dashboard.ngrok.com/domains
NGROK_DOMAIN=

# OPTIONAL: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
